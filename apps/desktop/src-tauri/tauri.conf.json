{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlayFX",
  "version": "0.2.3",
  "identifier": "dev.deblanco.playfx",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PlayFX",
        "width": 1280,
        "height": 760,
        "minWidth": 640,
        "minHeight": 400,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* ws://localhost:*"
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDNDExQkEwQUZEMEIwQ0IKUldUTHNOQ3ZvQnRCM09VbDU4cjk2ellwOWZKN0Y3ZzFiSXdFYzFEb3E4UlN1eWhLdU52NitRaHUK",
      "endpoints": [
        "https://github.com/deblanco/PlayFX/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "\u00a9 2026 Daniel B. AGPL-3.0.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "files": {
        "Resources/LICENSE": "../../../LICENSE",
        "Resources/NOTICE": "../../../NOTICE",
        "Resources/THIRD_PARTY_LICENSES": "../../../THIRD_PARTY_LICENSES"
      }
    }
  }
}
