{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlayFX",
  "version": "0.1.0",
  "identifier": "dev.deblanco.playfx",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PlayFX",
        "width": 1280,
        "height": 760,
        "minWidth": 640,
        "minHeight": 400,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Daniel B.. AGPL-3.0.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "files": {
        "Resources/LICENSE": "../../../LICENSE",
        "Resources/NOTICE": "../../../NOTICE"
      }
    }
  }
}
